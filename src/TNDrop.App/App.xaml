<Application x:Class="TNDrop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:TNDrop"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!--
            Text-scale sizes (Task 17). Defaults here match TextScale.Normal so the designer and
            any window shown before App.OnStartup runs (there is none today, but a future one)
            render at a sane size. App.OnStartup overwrites both with TextScaleMap.Apply as soon
            as Settings.TextScale is loaded, and SettingsWindow calls the same helper on every
            live change - see TextScaleMap's doc comment for why only one method ever computes
            these two numbers.
        -->
        <sys:Double x:Key="CardFontSize">13</sys:Double>
        <sys:Double x:Key="CardSmallFontSize">11</sys:Double>
    </Application.Resources>
</Application>
