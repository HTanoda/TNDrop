<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- NotifyIcon 用のみ -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>TNDrop</AssemblyName>
    <RootNamespace>TNDrop</RootNamespace>
    <Version>1.3.1</Version>
    <Authors>HIROKI TANODA (TND)</Authors>
    <Copyright>Copyright (c) 2026 HIROKI TANODA (TND). All rights reserved.</Copyright>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- v1.3.1 help (?) button: bundled README.html, linked into the publish output ROOT
         (not assets\README.html) so ShelfWindow.OnHelpButtonClick's
         Path.Combine(AppContext.BaseDirectory, "README.html") finds it. setup.iss needs no
         change - [Files] already copies dist\publish\* wholesale (verified by build). -->
    <Content Include="..\..\assets\README.html">
      <Link>README.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
