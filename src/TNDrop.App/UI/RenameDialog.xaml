<Window x:Class="TNDrop.UI.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="170"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FF1A1A1F"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <!--
        Standard window chrome (same reasoning as EditDialog's own comment): this window needs
        real activation and normal keyboard focus for its TextBox, unlike the click-through
        overlay windows in this app (indicator/edge-trigger bands). ResizeMode is NoResize (unlike
        EditDialog's CanResize) because a single-line stack name never needs extra room to grow.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Dlg.Foreground" Color="#FFF2F2F7" />
        <SolidColorBrush x:Key="Dlg.SubForeground" Color="#FFA5A5AD" />
        <SolidColorBrush x:Key="Dlg.Border" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="Dlg.HoverBorder" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="Dlg.FieldBackground" Color="#FF232329" />
        <SolidColorBrush x:Key="Dlg.ErrorForeground" Color="#FFFF6B6B" />

        <!--
            Shared FocusVisualStyle (same as EditDialog.xaml's own Dlg.FocusVisual): WPF's
            default FocusVisualStyle draws its dashed keyboard-focus adorner with a
            SystemColors-tracking brush, near-invisible against this window's permanent
            #FF1A1A1F background. This dialog is reached by Tab as a real keyboard path, so a
            visible ring matters here too. Applied below to the TextBox and Dlg.Button.
        -->
        <Style x:Key="Dlg.FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   Stroke="#B3FFFFFF"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="1 2"
                                   RadiusX="5" RadiusY="5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dlg.Foreground}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="Dlg.Button" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A31" />
            <Setter Property="Foreground" Value="{StaticResource Dlg.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Dlg.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Dlg.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center"
                                               RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Dlg.HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="NameTextBox"
                 Grid.Row="0"
                 FontSize="13"
                 Padding="8,6"
                 Background="{StaticResource Dlg.FieldBackground}"
                 Foreground="{StaticResource Dlg.Foreground}"
                 BorderBrush="{StaticResource Dlg.Border}"
                 CaretBrush="{StaticResource Dlg.Foreground}"
                 FocusVisualStyle="{StaticResource Dlg.FocusVisual}" />
        <TextBlock Grid.Row="1"
                   x:Name="HintText"
                   Margin="2,8,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Dlg.SubForeground}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource Dlg.Button}" MinWidth="96"
                    IsDefault="True" Click="OnSaveClick" />
            <Button x:Name="CancelButton" Style="{StaticResource Dlg.Button}" MinWidth="96" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
