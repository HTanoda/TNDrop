<Window x:Class="TNDrop.UI.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNDrop"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Left="-340" Top="0" Width="340" Height="600"
        Background="Transparent"
        AllowDrop="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Cards.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Panel"
            Background="#F01A1A1F"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="0,12,12,0"
            SnapsToDevicePixels="True">
        <Grid Margin="14,16,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PlaceholderTitle"
                       Grid.Row="0"
                       Text="TNDrop"
                       Margin="2,0,0,10"
                       HorizontalAlignment="Left"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#FFF2F2F7" />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Background="#2A2A31"
                         BorderThickness="0"
                         Foreground="#FFF2F2F7"
                         CaretBrush="#FFF2F2F7"
                         FontSize="{DynamicResource CardFontSize}">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock x:Name="SearchPlaceholderText"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource CardFontSize}"
                           Foreground="#FF6B6B73"
                           IsHitTestVisible="False" />
            </Grid>

            <WrapPanel x:Name="FilterTabs"
                       Grid.Row="2"
                       Orientation="Horizontal"
                       Margin="0,0,0,10">
                <Button x:Name="FilterAllButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
                <Button x:Name="FilterTextButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
                <Button x:Name="FilterLinksButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
                <Button x:Name="FilterImagesButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
                <Button x:Name="FilterFilesButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
            </WrapPanel>

            <ScrollViewer x:Name="PinnedScroll"
                          Grid.Row="3"
                          Margin="0,0,0,10"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <ItemsControl x:Name="PinnedList"
                              ItemsSource="{Binding PinnedCards}"
                              ItemTemplate="{StaticResource CardItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter" BasedOn="{StaticResource Card.PinnedContainerStyle}" />
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>

            <ListBox x:Name="CardsList"
                     Grid.Row="4"
                     ItemsSource="{Binding Cards}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource CardItemTemplate}"
                     ItemContainerStyle="{StaticResource Card.ListBoxItemStyle}"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionMode="Single">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- Batch action bar (Task 15): shown only while ShelfViewModel.SelectionMode is true
                 (toggled in code-behind, see UpdateSelectionBar; every other imperative on/off
                 switch in this window, e.g. UpdatePinnedVisibility, follows the same pattern
                 rather than a XAML binding+converter for a single boolean). -->
            <Grid x:Name="SelectionBar" Grid.Row="5" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SelectAllButton" Grid.Column="0" Style="{StaticResource SelectionBarButtonStyle}" />
                <Button x:Name="CopySelectedButton" Grid.Column="1" Style="{StaticResource SelectionBarButtonStyle}" />
                <Button x:Name="DeleteSelectedButton" Grid.Column="2" Style="{StaticResource SelectionBarButtonStyle}" />
                <Button x:Name="ClearSelectionButton" Grid.Column="3" Style="{StaticResource SelectionBarButtonStyle}" />
                <TextBlock x:Name="SelectedCountText"
                           Grid.Column="4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource CardSmallFontSize}"
                           Foreground="#FFA5A5AD" />
            </Grid>

            <Grid x:Name="Footer" Grid.Row="6" Margin="0,10,0,0">
                <!-- Two columns rather than one overlapping cell: the status line has to trim
                     against the Clear button instead of sliding underneath it, and that needs a
                     real width constraint. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Transient inline feedback for actions that could not be carried out (a Files
                     card whose paths are all gone, an image whose blob was deleted). Shown here
                     rather than as a per-card overlay so it survives the card list being rebuilt
                     underneath it, and so it can never cover a card's own content. Hidden again
                     by ShelfWindow's status timer. -->
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="2,0,8,0"
                           FontSize="{DynamicResource CardSmallFontSize}"
                           Foreground="#FFFF9F4A"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Padding="10,6"
                        HorizontalAlignment="Right"
                        Background="#2A2A31"
                        Foreground="#FFF2F2F7"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
