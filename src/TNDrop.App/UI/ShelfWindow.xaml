<Window x:Class="TNDrop.UI.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNDrop"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Left="-340" Top="0" Width="340" Height="600"
        Background="Transparent"
        AllowDrop="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Cards.xaml" />
                <ResourceDictionary Source="Scrollbars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Panel"
            Background="#F01A1A1F"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="0,12,12,0"
            SnapsToDevicePixels="True">
        <Grid Margin="14,16,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header (v1.1 Task C): app name left, settings (opens the same window the tray's
                 own "設定..." menu item opens - see App.OpenSettingsWindow), help (v1.3.1, opens
                 the bundled README.html - see ShelfWindow.OnHelpButtonClick) and hide (SlideOut,
                 same as the retract timer) right, in that order - matching the "?" button's slot
                 between the gear and the × in the README's own hero mockup (assets/README.html).
                 All three buttons use Header.IconButtonStyle (Cards.xaml), which sets
                 Focusable=False so a click never steals keyboard focus. -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Text is set in code-behind from Strings.AppName (see ShelfWindow's
                     constructor), the same pattern TrayIcon.cs uses for its own tooltip: not
                     hardcoded here, so a locale swap of AppName in the resx does not also need a
                     XAML edit to stay in sync. -->
                <TextBlock x:Name="PlaceholderTitle"
                           Grid.Column="0"
                           Margin="2,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FFF2F2F7" />

                <Button x:Name="HeaderSettingsButton"
                        Grid.Column="1"
                        Content="&#9881;"
                        Style="{StaticResource Header.IconButtonStyle}" />

                <Button x:Name="HeaderHelpButton"
                        Grid.Column="2"
                        Content="?"
                        Style="{StaticResource Header.IconButtonStyle}" />

                <Button x:Name="HeaderHideButton"
                        Grid.Column="3"
                        Content="&#215;"
                        Style="{StaticResource Header.IconButtonStyle}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <!-- Right padding (34 = button's 26 width + its 4 right margin + a small gap)
                     clears the × clear button (v1.2 Task F) below so long search text
                     wraps/trims before it runs under the button instead of behind it. -->
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6,34,6"
                         Background="#2A2A31"
                         BorderThickness="0"
                         Foreground="#FFF2F2F7"
                         CaretBrush="#FFF2F2F7"
                         FontSize="{DynamicResource CardFontSize}">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock x:Name="SearchPlaceholderText"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource CardFontSize}"
                           Foreground="#FF6B6B73"
                           IsHitTestVisible="False" />

                <!-- Search clear button (v1.2 Task F): shown only while SearchBox has text (see
                     OnSearchTextChanged), clears SearchText via the TwoWay binding above and
                     restores keyboard focus to the search box if the click came from a focused
                     box (see OnSearchClearButtonClick). Header.IconButtonStyle already gives it
                     Focusable="False" - the same convention as the header ⚙/× buttons - so a
                     click here never grabs activation on its own. Width/Height are left at the
                     style's own 26x26 (only Margin is overridden, to sit flush against the RIGHT
                     edge here instead of the style's default left-stacking margin) so this button
                     matches its header siblings exactly rather than being its own smaller size. -->
                <Button x:Name="SearchClearButton"
                        Content="&#215;"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource Header.IconButtonStyle}"
                        Visibility="Collapsed" />
            </Grid>

            <WrapPanel x:Name="FilterTabs"
                       Grid.Row="2"
                       Orientation="Horizontal"
                       Margin="0,0,0,10">
                <Button x:Name="FilterAllButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
                <Button x:Name="FilterTextButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
                <Button x:Name="FilterLinksButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
                <Button x:Name="FilterImagesButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
                <Button x:Name="FilterFilesButton" Style="{StaticResource FilterTabButtonStyle}" Margin="0,0,6,6" />
            </WrapPanel>

            <!-- Pinned accordion (v1.2 Task H). Replaces v1.1's horizontal pinned deck: a header
                 row that toggles a normal VERTICAL card list sitting directly above the unpinned
                 list, so pinned and unpinned cards share one column and one set of card visuals.
                 The whole section is hidden by UpdatePinnedVisibility when nothing is pinned -
                 a header saying "0" is noise, not information.

                 PinnedList keeps its name and its ItemsSource: ShelfWindow's card gesture handlers
                 (press/capture/drag/merge, Tasks 12/14) and FindLiveCardRoot are attached to it by
                 name alongside CardsList, and only the panel orientation and the container style
                 change here. Do not rename it without following those call sites.

                 v1.3 Task E: the accordion outgrew a bare StackPanel - users could not tell where
                 the pinned section ended and the unpinned list began. x:Name="PinnedSection" moved
                 from the inner StackPanel to this Border so UpdatePinnedVisibility's
                 PinnedSection.Visibility toggle (a plain FrameworkElement property, unaffected by
                 the element type) now hides the tint and hairline together with the content - a
                 section that shows the boundary while empty would be worse than the flat look it
                 replaces. Background is a ~7% white tint (Card.Background is already near-opaque
                 dark, so this reads as a faint lightening, not a colored banner) and
                 BorderThickness="0,0,0,1" draws a single hairline only along the bottom edge,
                 separating the pinned column from CardsList's Grid.Row="4" below. Both stay inside
                 the #0D-#14 / #22FFFFFF restraint budget for a business app on a dark shelf. -->
            <Border x:Name="PinnedSection" Grid.Row="3" Margin="0,0,0,6" Visibility="Collapsed"
                    Background="#12FFFFFF" CornerRadius="8"
                    BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
                <StackPanel Margin="6,4,6,6">
                    <Button x:Name="PinnedHeaderButton" Style="{StaticResource Pinned.HeaderButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="&#128204;"
                                           FontSize="{DynamicResource CardSmallFontSize}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <!-- Text set in code-behind from Strings.PinnedHeaderFormat, same
                                     pattern as the header title and the footer count. -->
                                <TextBlock x:Name="PinnedHeaderText"
                                           FontSize="{DynamicResource CardSmallFontSize}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Chevron. Points up while expanded and rotates 180 degrees on collapse
                                 (UpdatePinnedVisibility animates the Angle). RenderTransformOrigin is
                                 the glyph's own centre so it spins in place rather than swinging. -->
                            <TextBlock x:Name="PinnedChevron"
                                       Grid.Column="1"
                                       Text="&#8963;"
                                       FontSize="{DynamicResource CardFontSize}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,2,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="PinnedChevronRotation" Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <!-- MaxHeight is set from the placed shelf rect in code-behind (see Place): a user
                         with a dozen pinned items must not be able to squeeze the main list, whose row
                         is a star, down to nothing. Vertical scrolling inside the section is what pays
                         for that, hence the ScrollViewer. -->
                    <ScrollViewer x:Name="PinnedScroll"
                                  Margin="0,6,0,4"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <!-- Padding="0,8,0,0" (v1.3 Task D review round 1): reserves room, inside the
                             scrollable viewport itself, for the hover-action pill's ~6px overhang above
                             a card's own top edge (see Cards.xaml's ActionPill comment) - the
                             ScrollViewer's viewport clip is always active regardless of ClipToBounds
                             elsewhere in the tree, so at scroll offset 0 (where the shelf always opens)
                             the topmost card's pill would otherwise have its top corners flattened
                             against the viewport edge. Matches CardsList's own Padding below so the
                             pinned and unpinned sections behave identically. -->
                        <ItemsControl x:Name="PinnedList"
                                      ItemsSource="{Binding PinnedCards}"
                                      ItemTemplate="{StaticResource CardItemTemplate}"
                                      Padding="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter" BasedOn="{StaticResource Card.PinnedContainerStyle}" />
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Padding="0" (v1.3 Task D review round 2 - I1 fix): review round 1's
                 Padding="0,8,0,0" on this ListBox looked right but is INEFFECTIVE - unlike a plain
                 ItemsControl (see PinnedList's own comment above), a ListBox's default template has
                 its OWN internal ScrollViewer, and Padding forwards to that ScrollViewer's own
                 Padding, which becomes a Margin on its ScrollContentPresenter. That INSETS the
                 scrollable VIEWPORT itself rather than pushing the first item's content down inside
                 it - the topmost card still starts at content Y=0 within the (now smaller) viewport,
                 so the pill's -6px overhang above it still lands at Y<0 and gets clipped at scroll
                 offset 0, exactly as before. Fixed at the actual source instead: the reservation now
                 lives on the ItemsPanel (the VirtualizingStackPanel below) via Margin, which offsets
                 the ITEMS themselves within whatever viewport the ScrollViewer gives them, the same
                 way PinnedList's ItemsControl.Padding already did (an ItemsControl's default
                 template has no ScrollViewer of its own to forward Padding to, so that Padding always
                 acted directly on content - it was never broken). Verified with a probe: topmost
                 unpinned card at scroll offset 0, pill fully rounded and unclipped. -->
            <ListBox x:Name="CardsList"
                     Grid.Row="4"
                     Padding="0"
                     ItemsSource="{Binding Cards}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource CardItemTemplate}"
                     ItemContainerStyle="{StaticResource Card.ListBoxItemStyle}"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionMode="Single">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" Margin="0,8,0,0" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- Batch action bar (Task 15): shown only while ShelfViewModel.SelectionMode is true
                 (toggled in code-behind, see UpdateSelectionBar; every other imperative on/off
                 switch in this window, e.g. UpdatePinnedVisibility, follows the same pattern
                 rather than a XAML binding+converter for a single boolean). -->
            <Grid x:Name="SelectionBar" Grid.Row="5" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SelectAllButton" Grid.Column="0" Style="{StaticResource SelectionBarButtonStyle}" />
                <Button x:Name="CopySelectedButton" Grid.Column="1" Style="{StaticResource SelectionBarButtonStyle}" />
                <Button x:Name="DeleteSelectedButton" Grid.Column="2" Style="{StaticResource SelectionBarButtonStyle}" />
                <Button x:Name="ClearSelectionButton" Grid.Column="3" Style="{StaticResource SelectionBarButtonStyle}" />
                <TextBlock x:Name="SelectedCountText"
                           Grid.Column="4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource CardSmallFontSize}"
                           Foreground="#FFA5A5AD" />
            </Grid>

            <Grid x:Name="Footer" Grid.Row="6" Margin="0,10,0,0">
                <!-- Two columns rather than one overlapping cell: the status line has to trim
                     against the Clear button instead of sliding underneath it, and that needs a
                     real width constraint. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Card count (v1.1 Task C): "全 {0} 件", or "{0} / 全 {1} 件" once a filter or
                     search narrows the list - see ShelfWindow.UpdateFooterCount. Occupies the same
                     cell as StatusText below rather than a column of its own: the two are mutually
                     exclusive (a transient failure message briefly replaces the count), toggled by
                     ShowStatus/OnStatusTick so the count text is never both stale and visible at
                     once. -->
                <TextBlock x:Name="CountText"
                           Grid.Column="0"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="2,0,8,0"
                           FontSize="{DynamicResource CardSmallFontSize}"
                           Foreground="{StaticResource Card.SubForeground}"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False" />

                <!-- Transient inline feedback for actions that could not be carried out (a Files
                     card whose paths are all gone, an image whose blob was deleted). Shown here
                     rather than as a per-card overlay so it survives the card list being rebuilt
                     underneath it, and so it can never cover a card's own content. Hidden again
                     by ShelfWindow's status timer. -->
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="2,0,8,0"
                           FontSize="{DynamicResource CardSmallFontSize}"
                           Foreground="#FFFF9F4A"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Padding="10,6"
                        HorizontalAlignment="Right"
                        Background="#2A2A31"
                        Foreground="#FFF2F2F7"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
