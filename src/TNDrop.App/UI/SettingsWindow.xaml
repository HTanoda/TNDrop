<Window x:Class="TNDrop.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="560"
        MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="False"
        Background="#FF1A1A1F"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        Standard window chrome on purpose (per the Task 17 brief): unlike the shelf/edge-trigger/
        indicator windows, this one needs real activation and normal title-bar behavior - the
        user clicks into combo boxes and sliders here, and a WS_EX_NOACTIVATE window (the pattern
        every OTHER window in this app uses) would fight every one of those clicks.

        Layout: fixed-width nav on the left, one ScrollViewer per category on the right. All
        three ScrollViewers are created once and kept alive for the window's whole lifetime -
        switching category only toggles Visibility (see SettingsWindow.xaml.cs SetCategory) - so
        each one's scroll position survives a category switch for free, with no explicit
        save/restore needed (contrast ShelfWindow's OnStoreRebuilding/OnStoreRebuilt, which need
        one because THAT list is torn down and rebuilt on every store change).

        Every control here is immediate-apply: there is no OK/Cancel, no local draft state. Each
        one's change handler in the code-behind calls straight into an App.Set* method, which
        writes Settings, calls App.SaveSettings(), and pushes the change out to whatever live
        window/service reads it. See App.xaml.cs's "Settings window entry points" section.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Overlay scrollbar (v1.2 Task F), shared with ShelfWindow - see Scrollbars.xaml. -->
                <ResourceDictionary Source="Scrollbars.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Settings.Foreground" Color="#FFF2F2F7" />
        <SolidColorBrush x:Key="Settings.SubForeground" Color="#FFA5A5AD" />
        <SolidColorBrush x:Key="Settings.NavBackground" Color="#FF17171B" />
        <SolidColorBrush x:Key="Settings.Border" Color="#22FFFFFF" />
        <!-- Hover-state border/stroke brighten, shared by every hover-only-highlight control in
             this window (ComboBoxToggle, and Task F's CheckBox/RadioButton) so the three don't
             each carry their own copy of the same literal. -->
        <SolidColorBrush x:Key="Settings.HoverBorder" Color="#55FFFFFF" />

        <!--
            Shared FocusVisualStyle (Task B, v1.4): WPF's own default FocusVisualStyle draws its
            dashed keyboard-focus adorner with {DynamicResource SystemColors.ControlTextBrushKey},
            which tracks the OS theme, not this window's own permanent dark palette - on a
            light-theme OS (the department default) that resolves to near-black, invisible against
            this window's #FF1A1A1F background. Confirmed in the v1.3 final review as the one
            deliberate leftover from the Task F black-text sweep: FocusVisualStyle is an adorner
            resolved by the focus-visual layer outside the control's own ControlTemplate, so the
            grep-based black-pixel sweep that caught every other literal-black label never saw it.
            One Style, referenced by a FocusVisualStyle Setter on every focusable control's own
            Style below (CheckBox/RadioButton/ComboBox/Slider/Settings.NavButton) rather than each
            one carrying its own copy - same one-shared-resource precedent as Settings.Border and
            Settings.HoverBorder above. Negative margin expands the adorner rectangle outward from
            the adorned control's own bounds (WPF resolves FocusVisualStyle against an
            AdornedElementPlaceholder sized to the control's render bounds), so the ring sits just
            outside each control instead of overlapping its own label/glyph.
        -->
        <Style x:Key="Settings.FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   Stroke="#B3FFFFFF"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="1 2"
                                   RadiusX="5" RadiusY="5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Full re-template (Task F, v1.3), same reasoning as the ComboBox chrome below: the
            default Aero2 CheckBox glyph (the box) is drawn from PresentationFramework's own
            baked-in theme template, not this Style's plain Foreground/Background Setters -
            confirmed via a throwaway reflection dump of the real default ControlTemplate, whose
            box/check colors are fixed light-UI hex values (#FFF0F0F0 fill, #FFACACAC border,
            #FFDCECFC/#FF7EB4EA hover, #FFDAECFC/#FF569DE5 drag) baked for a light window, not
            SystemColors exactly but just as theme-fixed and just as wrong sitting on this
            window's permanent #FF1A1A1F dark background - a plain white box glaring out of a
            dark checkbox row. No TemplatePartAttribute is declared on CheckBox (confirmed via
            reflection), so this template owes no PART_ name.
        -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    CornerRadius="4"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource Settings.Border}"
                                    Background="Transparent"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M2.5,8.2 L6.3,12 L13.5,3.6"
                                      Stretch="Uniform"
                                      Margin="3"
                                      Stroke="{StaticResource Settings.Foreground}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Settings.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Settings.HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same reasoning as CheckBox above, circular glyph instead of a box. No
             TemplatePartAttribute on RadioButton either (confirmed via reflection). -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring"
                                         StrokeThickness="1.5"
                                         Stroke="{StaticResource Settings.Border}"
                                         Fill="Transparent" />
                                <Ellipse x:Name="Dot"
                                         Width="8" Height="8"
                                         Fill="{StaticResource Settings.Foreground}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Settings.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Settings.HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
        </Style>
        <!--
            Explicit palette (Task C), full re-template rather than a Style setter: the default
            ComboBox chrome (closed box AND dropdown popup) is drawn by Windows' native visual-
            style renderer, not a lookless XAML template, so plain Background/Foreground Setters
            on ComboBox are silently ignored by the chrome itself - confirmed empirically by the
            Task C probe screenshot, which showed near-invisible pale text on an unstyled light-
            grey box despite an explicit Foreground already being set. Ambient SystemColors brushes
            (and, transitively, this native chrome) track the *current Windows theme/accent*, not
            this window's own always-dark palette, which is exactly the failure mode this task
            exists to close off. Same precedent as Scrollbars.xaml (Task F): give the control its
            own lookless ControlTemplate so every color is a Setter here, not an ambient default.
        -->
        <Style x:Key="Settings.ComboBoxToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1"
                                      Data="M0,0 L6,6 L12,0 Z"
                                      Fill="{StaticResource Settings.SubForeground}"
                                      Width="12" Height="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Settings.HoverBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
            <Setter Property="Background" Value="#FF232329" />
            <Setter Property="BorderBrush" Value="{StaticResource Settings.Border}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButtonPart"
                                          Style="{StaticResource Settings.ComboBoxToggle}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                            <!-- Named PART_Popup, not just "Popup" (Task C review #1 fix):
                                 ComboBox declares [TemplatePart(Name = "PART_Popup", Type =
                                 typeof(Popup))] and its own OnApplyTemplate resolves that exact
                                 name into a private _dropDownPopup field. A differently-named
                                 Popup still opens/closes fine via the IsOpen/IsDropDownOpen
                                 binding below (that part is our own wiring, name-independent),
                                 but _dropDownPopup stays null - confirmed empirically with a
                                 throwaway probe comparing a misnamed vs. correctly-named minimal
                                 template side by side, since ComboBox's actual internal use of
                                 that field is undocumented and not worth asserting more precisely
                                 than "every built-in piece of ComboBox's own dropdown-popup
                                 handling that reads _dropDownPopup silently no-ops", which
                                 includes (per manual verification pending, see
                                 manual-test-checklist.md #16-14) the built-in click-outside-the-
                                 dropdown-to-dismiss-without-selecting behavior. -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#FF232329"
                                        BorderBrush="{StaticResource Settings.Border}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Dropdown rows: same explicit-pair reasoning as the ComboBox chrome above. Reached by
             the custom ItemsPresenter/ScrollViewer inside the Popup border. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
            <Setter Property="Background" Value="#FF232329" />
            <Setter Property="Padding" Value="8,5" />
            <!-- Review round 1 fix (Task B): ComboBoxItem is a real keyboard-focus target, not
                 just a mouse-hover row - opening the dropdown and pressing Down moves literal
                 Keyboard.FocusedElement onto the highlighted ComboBoxItem (confirmed by review).
                 Without this setter it fell back to WPF's own default FocusVisualStyle (the
                 SystemColors-tracking dashed adorner), which is exactly the bug this task
                 removes everywhere else - reachable via arrow keys in every ComboBox in this
                 window (AutoDeleteCombo/HistoryCapacityCombo/MonitorCombo). -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF34343D" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--
            Foreground was missing here until Task F (v1.3): TextBlock.Foreground is an
            inheritable property whose OWN CLR default is a fixed Brushes.Black (confirmed via a
            throwaway reflection probe - not a SystemColors DynamicResource, so it does not track
            the OS theme at all), and this key-styled Style completely replaces the file's
            unkeyed/implicit "Style TargetType=TextBlock" (Settings.Foreground) rather than
            inheriting from it - an explicit Style="{StaticResource ...}" bypasses implicit-style
            lookup entirely, so nothing here fell back to that default either. Every one of this
            window's section headers (自動削除, 履歴の容量, エッジ, モニター, ...) was rendering
            literal black text on the #FF1A1A1F background - confirmed empirically: a probe
            script that flags every literal (0,0,0) pixel in a rendered screenshot lit up exactly
            these labels, on every one of the three category pages, and only these labels. This
            is the single highest-impact fix in the Task F sweep.
        -->
        <!--
            Slider (Task F, v1.3): same reasoning as CheckBox/RadioButton above. Reflection shows
            Slider actually declares TWO TemplatePartAttributes, not one:
            [TemplatePart(Name = "PART_Track", Type = typeof(Track))] and
            [TemplatePart(Name = "PART_SelectionRange", Type = typeof(FrameworkElement))] (the
            required type is FrameworkElement, not specifically Rectangle - the stock template
            just happens to use a Rectangle for it). This template supplies PART_Track only.
            PART_SelectionRange is deliberately omitted: it backs Slider.IsSelectionRangeEnabled,
            which nothing in this window ever sets (every Slider here is a single-value control,
            not a range), so nothing looks it up. Per a throwaway XamlWriter dump of the actual
            default ControlTemplate, Slider's own OnApplyTemplate wires PART_Track's
            Minimum/Maximum/Value/IsDirectionReversed itself - the default template does not
            TemplateBind any of them, so this one does not either. If a future Slider in this
            window ever sets IsSelectionRangeEnabled="True", a named PART_SelectionRange
            FrameworkElement (typically a Rectangle, positioned the way the stock template
            positions its own) must be added to this template first, or the selection-range
            highlight will silently fail to render - the same "wrong/missing PART_ name compiles
            fine and no-ops at runtime" risk the ComboBox PART_Popup note above documents.
            That same XamlWriter dump also confirms the concrete failure mode this task closes:
            the default thumb and track colors are fixed light-UI hex (#FFF0F0F0/#FFACACAC
            track+thumb, #FFE7EAEA/#FFD6D6D6 track background) and the selection-range rectangle
            itself uses a genuine SystemColors DynamicResource ({DynamicResource {x:Static
            SystemColors.HighlightBrushKey}}) - unused here, but exactly the ambient-theme
            dependency this whole task exists to close off wherever it CAN matter. Track's two
            RepeatButtons keep the real default's own trick of an invisible, non-focusable,
            non-tab-stop hit zone (Focusable/IsTabStop both False) purely for page-by-drag click
            paging - they carry no visible chrome of their own.
        -->
        <Style x:Key="Settings.SliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Settings.SliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="Knob" Fill="{StaticResource Settings.Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="{StaticResource Settings.Border}"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Settings.SliderRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Settings.SliderRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Settings.SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Settings.SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Settings.HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Settings.SubForeground}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Settings.FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="Settings.NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Settings.SubForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="14,10" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bordered content-area action button (v1.6 Task 8), for OpenBackupDialogButton: distinct
             from Settings.NavButton above (that one is the borderless left-sidebar nav item).
             Same shape as BackupDialog.xaml's own Dlg.Button - bordered box, hover-brightened
             border, half-opacity when disabled - rebuilt against this window's own Settings.*
             resources (Foreground/Border/HoverBorder/FocusVisual) instead of BackupDialog's Dlg.*
             ones, since the two windows keep separate resource dictionaries. -->
        <Style x:Key="Settings.Button" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A31" />
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Settings.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center"
                                               RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Settings.HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular color swatch (v1.5): a RadioButton whose Background carries the preset
             color (set per instance in code-behind, where the swatches are built from the same
             preset table that maps hex to name). Re-templated for the same reason as
             CheckBox/RadioButton above - every color must be a Setter here, not an ambient
             default. The outer ring shows the checked state. -->
        <Style x:Key="Settings.ColorSwatch" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                            <Ellipse Width="18" Height="18"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="#33FFFFFF" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Settings.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Settings.HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="{StaticResource Settings.NavBackground}">
                <Button x:Name="NavBehaviorButton" Style="{StaticResource Settings.NavButton}" Margin="6,12,6,2" />
                <Button x:Name="NavPositionButton" Style="{StaticResource Settings.NavButton}" />
                <Button x:Name="NavAppearanceButton" Style="{StaticResource Settings.NavButton}" />
            </StackPanel>

            <Grid Grid.Column="1">
                <!-- 動作 -->
                <ScrollViewer x:Name="BehaviorScroll" Padding="24,22,24,22" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--
                            Every checkbox item in this window follows the same shape (v1.2 Task
                            C, generalized from the PasteOnClick pattern Task H introduced below):
                            a StackPanel wraps the CheckBox (bottom margin trimmed to 2px) and an
                            indented (20px, matching the checkbox's own label inset) HintText
                            description underneath it. The shared CheckBox style's 14px bottom
                            margin would otherwise open a gap between the box and its own
                            explanation, so that margin moves onto the description instead.
                        -->
                        <StackPanel>
                            <CheckBox x:Name="AutoStartCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="AutoStartDescText" Style="{StaticResource Settings.HintText}" Margin="20,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <CheckBox x:Name="SoundsCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="SoundsDescText" Style="{StaticResource Settings.HintText}" Margin="20,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <CheckBox x:Name="IncognitoCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="IncognitoDescText" Style="{StaticResource Settings.HintText}" Margin="20,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <CheckBox x:Name="HoverCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="HoverDescText" Style="{StaticResource Settings.HintText}" Margin="20,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 自動バックアップ (v1.6 Task 8): トグル + ダイアログ入口ボタン。他の項目と
                             違い専用の説明テキストは持たず、チェックボックスのラベル文言自体が
                             説明を兼ねる (Strings.SettingsAutoBackup)。 -->
                        <StackPanel Margin="0,0,0,14">
                            <CheckBox x:Name="AutoBackupCheckBox" Margin="0,0,0,2" />
                            <Button x:Name="OpenBackupDialogButton" Style="{StaticResource Settings.Button}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="AutoDeleteLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <ComboBox x:Name="AutoDeleteCombo" Width="220" HorizontalAlignment="Left" />
                            <TextBlock x:Name="AutoDeleteDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel>
                            <CheckBox x:Name="PurgeUnpinnedOnRestartCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="PurgeUnpinnedOnRestartDescText" Style="{StaticResource Settings.HintText}" Margin="20,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="HistoryCapacityLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <ComboBox x:Name="HistoryCapacityCombo" Width="160" HorizontalAlignment="Left" />
                            <TextBlock x:Name="HistoryCapacityDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel>
                            <CheckBox x:Name="MoveToTopCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="MoveToTopDescText" Style="{StaticResource Settings.HintText}" Margin="20,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- クリックで貼り付け (v1.2 Task H). The one setting in this window that
                             sends keystrokes into OTHER applications, and the only one whose scope
                             (text/link cards, the previously focused app, suppressed while a
                             modifier is held) cannot be guessed from its label, so it carried a
                             hint line before Task C generalized the same pattern to every other
                             item above and below it. -->
                        <StackPanel>
                            <CheckBox x:Name="PasteOnClickCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="PasteOnClickHintText"
                                       Style="{StaticResource Settings.HintText}"
                                       Margin="20,0,0,14"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="RetractDelayLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <Slider x:Name="RetractDelaySlider" Width="320" HorizontalAlignment="Left" />
                            <TextBlock x:Name="RetractDelayValueText" Style="{StaticResource Settings.HintText}" />
                            <TextBlock x:Name="RetractDelayDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 位置 -->
                <ScrollViewer x:Name="PositionScroll" Padding="24,22,24,22" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="EdgeLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EdgeLeftRadio" GroupName="Edge" />
                                <RadioButton x:Name="EdgeRightRadio" GroupName="Edge" />
                            </StackPanel>
                            <TextBlock x:Name="EdgeDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="MonitorLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <ComboBox x:Name="MonitorCombo" Width="360" HorizontalAlignment="Left" />
                            <TextBlock x:Name="MonitorDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="HotZoneLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HotZone25Radio" GroupName="HotZone" />
                                <RadioButton x:Name="HotZone40Radio" GroupName="HotZone" />
                                <RadioButton x:Name="HotZone60Radio" GroupName="HotZone" />
                            </StackPanel>
                            <TextBlock x:Name="HotZoneDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="TriggerSensitivityLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <Slider x:Name="TriggerSensitivitySlider" Width="220" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TriggerSensitivityValueText" Style="{StaticResource Settings.HintText}" />
                            <TextBlock x:Name="TriggerSensitivityDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="TriggerAlignLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TriggerAlignTopRadio" GroupName="TriggerAlign" />
                                <RadioButton x:Name="TriggerAlignCenterRadio" GroupName="TriggerAlign" />
                                <RadioButton x:Name="TriggerAlignBottomRadio" GroupName="TriggerAlign" />
                            </StackPanel>
                            <TextBlock x:Name="TriggerAlignDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel>
                            <CheckBox x:Name="TriggerHintCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="TriggerHintDescText" Style="{StaticResource Settings.HintText}" Margin="20,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 外観 -->
                <ScrollViewer x:Name="AppearanceScroll" Padding="24,22,24,22" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="TextScaleLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TextScaleSmallRadio" GroupName="TextScale" />
                                <RadioButton x:Name="TextScaleNormalRadio" GroupName="TextScale" />
                                <RadioButton x:Name="TextScaleMediumRadio" GroupName="TextScale" />
                                <RadioButton x:Name="TextScaleLargeRadio" GroupName="TextScale" />
                            </StackPanel>
                            <TextBlock x:Name="TextScaleDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel>
                            <CheckBox x:Name="IndicatorEnabledCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="IndicatorEnabledDescText" Style="{StaticResource Settings.HintText}" Margin="20,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="IndicatorStyleLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="IndicatorBulgeRadio" GroupName="IndicatorStyle" />
                                <RadioButton x:Name="IndicatorBeaconRadio" GroupName="IndicatorStyle" />
                                <RadioButton x:Name="IndicatorBarRadio" GroupName="IndicatorStyle" />
                                <RadioButton x:Name="IndicatorPulseRadio" GroupName="IndicatorStyle" />
                                <RadioButton x:Name="IndicatorCornerRadio" GroupName="IndicatorStyle" />
                            </StackPanel>
                            <TextBlock x:Name="IndicatorStyleDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="IndicatorColorLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel x:Name="IndicatorColorSwatchPanel" Orientation="Horizontal" />
                            <TextBlock x:Name="IndicatorColorDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="IndicatorOpacityLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <Slider x:Name="IndicatorOpacitySlider" Width="220" HorizontalAlignment="Left" />
                            <TextBlock x:Name="IndicatorOpacityValueText" Style="{StaticResource Settings.HintText}" />
                            <TextBlock x:Name="IndicatorOpacityDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="LanguageLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LanguageJaRadio" GroupName="Language" />
                                <RadioButton x:Name="LanguageEnRadio" GroupName="Language" />
                            </StackPanel>
                            <TextBlock x:Name="LanguageDescText" Style="{StaticResource Settings.HintText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="LanguageRestartNoteText" Style="{StaticResource Settings.HintText}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource Settings.Border}" BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock x:Name="FooterText"
                       Style="{StaticResource Settings.HintText}"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
