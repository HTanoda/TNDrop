<Window x:Class="TNDrop.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="560"
        MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="False"
        Background="#FF1A1A1F"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        Standard window chrome on purpose (per the Task 17 brief): unlike the shelf/edge-trigger/
        indicator windows, this one needs real activation and normal title-bar behavior - the
        user clicks into combo boxes and sliders here, and a WS_EX_NOACTIVATE window (the pattern
        every OTHER window in this app uses) would fight every one of those clicks.

        Layout: fixed-width nav on the left, one ScrollViewer per category on the right. All
        three ScrollViewers are created once and kept alive for the window's whole lifetime -
        switching category only toggles Visibility (see SettingsWindow.xaml.cs SetCategory) - so
        each one's scroll position survives a category switch for free, with no explicit
        save/restore needed (contrast ShelfWindow's OnStoreRebuilding/OnStoreRebuilt, which need
        one because THAT list is torn down and rebuilt on every store change).

        Every control here is immediate-apply: there is no OK/Cancel, no local draft state. Each
        one's change handler in the code-behind calls straight into an App.Set* method, which
        writes Settings, calls App.SaveSettings(), and pushes the change out to whatever live
        window/service reads it. See App.xaml.cs's "Settings window entry points" section.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Overlay scrollbar (v1.2 Task F), shared with ShelfWindow - see Scrollbars.xaml. -->
                <ResourceDictionary Source="Scrollbars.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Settings.Foreground" Color="#FFF2F2F7" />
        <SolidColorBrush x:Key="Settings.SubForeground" Color="#FFA5A5AD" />
        <SolidColorBrush x:Key="Settings.NavBackground" Color="#FF17171B" />
        <SolidColorBrush x:Key="Settings.Border" Color="#22FFFFFF" />

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Settings.Foreground}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Settings.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Settings.HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Settings.SubForeground}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Settings.FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="Settings.NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Settings.SubForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="14,10" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="{StaticResource Settings.NavBackground}">
                <Button x:Name="NavBehaviorButton" Style="{StaticResource Settings.NavButton}" Margin="6,12,6,2" />
                <Button x:Name="NavPositionButton" Style="{StaticResource Settings.NavButton}" />
                <Button x:Name="NavAppearanceButton" Style="{StaticResource Settings.NavButton}" />
            </StackPanel>

            <Grid Grid.Column="1">
                <!-- 動作 -->
                <ScrollViewer x:Name="BehaviorScroll" Padding="24,22,24,22" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheckBox" />
                        <CheckBox x:Name="SoundsCheckBox" />
                        <CheckBox x:Name="IncognitoCheckBox" />
                        <CheckBox x:Name="HoverCheckBox" />

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="AutoDeleteLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <ComboBox x:Name="AutoDeleteCombo" Width="220" HorizontalAlignment="Left" />
                        </StackPanel>

                        <CheckBox x:Name="PurgeUnpinnedOnRestartCheckBox" />

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="HistoryCapacityLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <ComboBox x:Name="HistoryCapacityCombo" Width="160" HorizontalAlignment="Left" />
                        </StackPanel>

                        <CheckBox x:Name="MoveToTopCheckBox" />

                        <!-- クリックで貼り付け (v1.2 Task H). The one setting in this window that
                             sends keystrokes into OTHER applications, and the only one whose scope
                             (text/link cards, the previously focused app, suppressed while a
                             modifier is held) cannot be guessed from its label, so it carries a
                             hint line now rather than waiting for Task C's full descriptions.
                             Wrapped in a StackPanel with the checkbox's bottom margin moved onto
                             the hint: the shared CheckBox style's 14px gap would otherwise open up
                             between the checkbox and its own explanation. -->
                        <StackPanel>
                            <CheckBox x:Name="PasteOnClickCheckBox" Margin="0,0,0,2" />
                            <TextBlock x:Name="PasteOnClickHintText"
                                       Style="{StaticResource Settings.HintText}"
                                       Margin="20,0,0,14"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="RetractDelayLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <Slider x:Name="RetractDelaySlider" Width="320" HorizontalAlignment="Left" />
                            <TextBlock x:Name="RetractDelayValueText" Style="{StaticResource Settings.HintText}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 位置 -->
                <ScrollViewer x:Name="PositionScroll" Padding="24,22,24,22" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="EdgeLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="EdgeLeftRadio" GroupName="Edge" />
                                <RadioButton x:Name="EdgeRightRadio" GroupName="Edge" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="MonitorLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <ComboBox x:Name="MonitorCombo" Width="360" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="HotZoneLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HotZone25Radio" GroupName="HotZone" />
                                <RadioButton x:Name="HotZone40Radio" GroupName="HotZone" />
                                <RadioButton x:Name="HotZone60Radio" GroupName="HotZone" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="TriggerSensitivityLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <Slider x:Name="TriggerSensitivitySlider" Width="220" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TriggerSensitivityValueText" Style="{StaticResource Settings.HintText}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="TriggerAlignLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TriggerAlignTopRadio" GroupName="TriggerAlign" />
                                <RadioButton x:Name="TriggerAlignCenterRadio" GroupName="TriggerAlign" />
                                <RadioButton x:Name="TriggerAlignBottomRadio" GroupName="TriggerAlign" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox x:Name="TriggerHintCheckBox" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 外観 -->
                <ScrollViewer x:Name="AppearanceScroll" Padding="24,22,24,22" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="TextScaleLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TextScaleSmallRadio" GroupName="TextScale" />
                                <RadioButton x:Name="TextScaleNormalRadio" GroupName="TextScale" />
                                <RadioButton x:Name="TextScaleMediumRadio" GroupName="TextScale" />
                                <RadioButton x:Name="TextScaleLargeRadio" GroupName="TextScale" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox x:Name="IndicatorEnabledCheckBox" />

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="IndicatorStyleLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="IndicatorBeaconRadio" GroupName="IndicatorStyle" />
                                <RadioButton x:Name="IndicatorBarRadio" GroupName="IndicatorStyle" />
                                <RadioButton x:Name="IndicatorPulseRadio" GroupName="IndicatorStyle" />
                                <RadioButton x:Name="IndicatorCornerRadio" GroupName="IndicatorStyle" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Settings.FieldGroup}">
                            <TextBlock x:Name="LanguageLabelText" Style="{StaticResource Settings.SectionLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LanguageJaRadio" GroupName="Language" />
                                <RadioButton x:Name="LanguageEnRadio" GroupName="Language" />
                            </StackPanel>
                            <TextBlock x:Name="LanguageRestartNoteText" Style="{StaticResource Settings.HintText}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource Settings.Border}" BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock x:Name="FooterText"
                       Style="{StaticResource Settings.HintText}"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
