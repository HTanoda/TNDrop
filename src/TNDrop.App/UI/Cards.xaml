<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TNDrop.UI"
                    xmlns:res="clr-namespace:TNDrop.Resources">

    <!--
        Card visuals for the shelf's card list, pinned deck, and (via the same template) any
        other place a CardViewModel needs to render.

        Design note (per task-10 brief: "DataTrigger or DataTemplateSelector, document it"):
        a single DataTemplate keyed off CardViewModel holds one sub-tree per Kind (Text / Link /
        Image / Files-single / Files-stack); DataTrigger/Trigger pairs in DataTemplate.Triggers
        toggle which sub-tree is Visible. This was chosen over a DataTemplateSelector so the
        whole card visual stays declarative in this one file, with no extra .cs class to keep in
        sync with the Kind enum.
    -->

    <SolidColorBrush x:Key="Card.Background" Color="#2A2A31" />
    <SolidColorBrush x:Key="Card.HoverBackground" Color="#34343C" />
    <SolidColorBrush x:Key="Card.Foreground" Color="#FFF2F2F7" />
    <SolidColorBrush x:Key="Card.SubForeground" Color="#FFA5A5AD" />
    <SolidColorBrush x:Key="Card.StackLayer1" Color="#FF3A3A42" />
    <SolidColorBrush x:Key="Card.StackLayer2" Color="#FF333339" />
    <SolidColorBrush x:Key="Card.StackLayer3" Color="#FF2E2E34" />
    <SolidColorBrush x:Key="Card.Badge" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="Card.ActionHover" Color="#40FFFFFF" />

    <!-- Hover-action pill (v1.3 Task D): a dark, near-opaque ground the pin/delete icons always
         sit on, so they stay legible over any card content including a white image - the earlier
         plain icons drawn straight onto the card were invisible there (spec feedback, referencing
         a similar pill toolbar pattern). Alpha E6 (~90%) rather than fully opaque keeps
         a hint of the card color coming through, matching that translucency without
         risking legibility on light content. -->
    <SolidColorBrush x:Key="Card.PillBackground" Color="#E61E1E23" />
    <SolidColorBrush x:Key="Card.PillSeparator" Color="#33FFFFFF" />

    <!-- Multi-select indicator (Task 15). Same accent as the Task 13/14 drop/merge highlight
         (#0A84FF) for visual consistency across the shelf's "this is active" affordances. -->
    <SolidColorBrush x:Key="Card.SelectedAccent" Color="#FF0A84FF" />

    <!-- The clickable "open this in the browser" hotspot on a Link card: the chain glyph + the
         bold domain line. Everything else on a link card re-copies the URL like any other card,
         so the hotspot has to look different from the rest - hence the hand cursor and the
         underline that appears on hover. ShelfWindow finds it by walking up from the click's
         OriginalSource looking for Tag="LinkOpen"; keep that tag in sync with
         ShelfWindow.LinkOpenTag. -->
    <Style x:Key="Card.LinkOpenText" TargetType="TextBlock">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <!-- On the StackPanel's IsMouseOver, not this TextBlock's: the glyph and the domain
                 are one hotspot, so hovering either underlines the domain. -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Shared chrome for the hover-only pin/delete buttons. Each Button carries
         Tag="Pin"/"Unpin"/"Delete" - ShelfWindow attaches one class handler
         (Button.ClickEvent) on the containing ItemsControl/ListBox and reads Tag +
         DataContext (the CardViewModel) from the event args, so this dictionary needs no
         code-behind of its own. -->
    <Style x:Key="Card.ActionButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Card.Foreground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card.ActionHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pin action button (v1.3 review fix I4): the pill's pin/delete buttons had no ToolTip or
         AutomationProperties.Name at all, and the pin glyph never changed with state - so a
         pinned card's button still read (visually and to a screen reader) as "pin", even though
         clicking it unpins. Strings.ActionPin/ActionUnpin already existed in both resx files,
         unused. Binding is plain "{Binding Pinned}", not RelativeSource - the Button's
         DataContext inside CardItemTemplate IS the CardViewModel already. Content/ToolTip/
         AutomationProperties.Name are set here rather than as local values on the Button in the
         template below, precisely so the DataTrigger can override them per-instance based on that
         binding - a local value on the element would outrank the Style's Setters and the trigger
         would never show. -->
    <Style x:Key="Card.PinActionButtonStyle" TargetType="Button" BasedOn="{StaticResource Card.ActionButton}">
        <Setter Property="Content" Value="&#128204;" />
        <Setter Property="ToolTip" Value="{x:Static res:Strings.ActionPin}" />
        <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.ActionPin}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Pinned}" Value="True">
                <Setter Property="Content" Value="&#128205;" />
                <Setter Property="ToolTip" Value="{x:Static res:Strings.ActionUnpin}" />
                <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.ActionUnpin}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Pill container for the hover-action bar (v1.3 Task D). CornerRadius is half the pill's own
         height (28/2=14) per apple-design's "corner radius = half height" pill shape; the shadow is
         deliberately subtle (low opacity, small blur) - this floats over card content on every
         hover, so a heavy shadow would be a constant distraction rather than the occasional
         emphasis a modal/menu shadow provides. -->
    <Style x:Key="Card.ActionPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card.PillBackground}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FF000000" Direction="270" ShadowDepth="1.5" BlurRadius="6" Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shelf header ⚙/× buttons (v1.1 Task C): small icon-only buttons in ShelfWindow's top row.
         Focusable=False keeps a click from taking keyboard focus even though the window can, in
         principle, be activated (the search box's own deliberate NOACTIVATE exception, see
         ShelfWindow.OnSearchBoxPreviewMouseLeftButtonDown) - unlike the search box, these two are
         never meant to grab focus, only to fire their Click. -->
    <Style x:Key="Header.IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Card.Foreground}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card.ActionHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="CardItemTemplate" DataType="{x:Type vm:CardViewModel}">
        <!-- AllowDrop is what makes a card a drop target in its own right (Task 14 merge): without
             it WPF raises DragOver/Drop on the nearest ancestor that has it, which is the shelf
             Window, and the card-level handlers would never see the drag. Padding is 8 rather than
             10 to pay for the 2px border, so a highlighted card is exactly the same size as an
             idle one and the list does not twitch as a drag passes over it. ShelfWindow finds this
             element by walking up from the drag's OriginalSource looking for Name="CardRoot"; keep
             the name in sync with ShelfWindow.CardRootName. -->
        <Border x:Name="CardRoot"
                Background="{StaticResource Card.Background}"
                BorderBrush="Transparent"
                BorderThickness="2"
                CornerRadius="10"
                Padding="8"
                AllowDrop="True"
                SnapsToDevicePixels="True">
            <Grid>
                <!-- Text: up to 3 lines, ellipsis. MaxHeight scales with CardFontSize via
                     CardTextMaxHeight (see TextScaleMap) - pinned to a fixed 58 it clipped the
                     third line's glyph tops at Medium/Large instead of trimming it. -->
                <TextBlock x:Name="TextContent"
                           Text="{Binding Title}"
                           ToolTip="{Binding Title}"
                           Foreground="{StaticResource Card.Foreground}"
                           FontSize="{DynamicResource CardFontSize}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           MaxHeight="{DynamicResource CardTextMaxHeight}"
                           Visibility="Collapsed" />

                <!-- Text stack (v1.8): the FilesStackContent layered-paper look with a memo glyph
                     in place of the shell icon. Count badge binds the same StackCount the file
                     stack badge uses (CardViewModel widened it to Texts.Count for text stacks). -->
                <Grid x:Name="TextStackContent" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="34" Height="34" Margin="0,0,10,0">
                        <Border Background="{StaticResource Card.StackLayer1}" CornerRadius="4"
                                Width="26" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,4,0,0" />
                        <Border Background="{StaticResource Card.StackLayer2}" CornerRadius="4"
                                Width="26" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="4,2,0,0" />
                        <Border Background="{StaticResource Card.StackLayer3}" CornerRadius="4"
                                Width="26" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Text="&#128221;"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Border Background="{StaticResource Card.Badge}" CornerRadius="8"
                                Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding StackCount}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   ToolTip="{Binding Title}"
                                   FontSize="{DynamicResource CardFontSize}"
                                   Foreground="{StaticResource Card.Foreground}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   ToolTip="{Binding Subtitle}"
                                   FontSize="{DynamicResource CardSmallFontSize}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource Card.SubForeground}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Link: chain glyph + bold domain + small full URL -->
                <StackPanel x:Name="LinkContent" Visibility="Collapsed">
                    <!-- Left-aligned and Transparent-backed on purpose: Left keeps the hotspot as
                         narrow as the glyph+domain (a stretched panel would turn the empty space
                         out to the card's right edge into "open the browser" too), and a
                         Transparent background is what makes the gaps between the two TextBlocks
                         hit-testable at all - a null Background is invisible to hit-testing. -->
                    <StackPanel Orientation="Horizontal"
                                Tag="LinkOpen"
                                HorizontalAlignment="Left"
                                Background="Transparent">
                        <TextBlock Text="&#128279;" FontSize="{DynamicResource CardFontSize}" Margin="0,0,6,0" Cursor="Hand" />
                        <!-- MaxWidth bound to the card's own content Grid (the outer, unnamed
                             Grid two levels up) rather than a Grid column: the hotspot has to
                             stay left-aligned and no wider than its content (a * Grid column
                             would stretch it across the card), so a Grid fix (used elsewhere in
                             this template) is not an option here. Binding to the ancestor Grid's
                             ActualWidth - instead of a single hardcoded number - is what keeps
                             this correct in both the full-width main list and the 200px-wide
                             pinned deck (Card.PinnedContainerStyle) with one rule, not two. -->
                        <TextBlock x:Name="LinkDomainText"
                                   Text="{Binding Title}"
                                   ToolTip="{Binding Title}"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource CardFontSize}"
                                   Foreground="{StaticResource Card.Foreground}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                   Style="{StaticResource Card.LinkOpenText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}"
                               ToolTip="{Binding Subtitle}"
                               FontSize="{DynamicResource CardSmallFontSize}"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource Card.SubForeground}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Image: thumbnail (lazily loaded by CardViewModel.Thumbnail) -->
                <Image x:Name="ImageContent"
                       Source="{Binding Thumbnail}"
                       Stretch="Uniform"
                       MaxHeight="140"
                       HorizontalAlignment="Left"
                       Visibility="Collapsed" />

                <!-- Files, single item, non-media (IsMediaFile==False): left-slot icon + name.
                     The left slot defaults to the shell extension icon (FileIconContent, lazily
                     loaded by CardViewModel.FileIcon); FileIconContent/FileIconGlyph swap via the
                     "FileIcon is null" trigger below, so a shell that has nothing to offer falls
                     back to the original generic-page glyph instead of an empty square. -->
                <StackPanel x:Name="FilesSingleContent" Visibility="Collapsed">
                    <!-- Grid (Auto icon column + * text column), not a horizontal StackPanel: a
                         StackPanel measures its children with infinite available width, so the
                         filename TextBlock never had a width to trim against and a very long name
                         laid out far past the card's edge instead of ellipsizing (v1.1 review).
                         FilesStackContent below already uses this same Auto/* shape correctly. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,6,0">
                            <Image x:Name="FileIconContent"
                                   Source="{Binding FileIcon}"
                                   Width="32" Height="32" />
                            <TextBlock x:Name="FileIconGlyph"
                                       Text="&#128196;"
                                       FontSize="{DynamicResource CardFontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="FilesSingleTitle"
                                   Grid.Column="1"
                                   Text="{Binding Title}"
                                   ToolTip="{Binding Title}"
                                   FontSize="{DynamicResource CardFontSize}"
                                   Foreground="{StaticResource Card.Foreground}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Text="{Binding Subtitle}"
                               ToolTip="{Binding Subtitle}"
                               FontSize="{DynamicResource CardSmallFontSize}"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource Card.SubForeground}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Files, single item, media (IsMediaFile==True): image or video, shown as a
                     large shell thumbnail in the same visual family as ImageContent above (full
                     card width, capped height, rounded corners) with the file name below on one
                     line. A Border with an ImageBrush Background is used instead of a plain Image
                     element so the corners come out rounded: WPF clips a Border's Background to
                     its own CornerRadius geometry for free, no code-behind clip needed. Height is
                     a fixed value (not MaxHeight): unlike ImageContent (an Image element, which
                     sizes itself from the source and MaxHeight only caps that), a Border painted
                     via brush has no intrinsic size at all, so it needs an explicit box for
                     UniformToFill to fill and crop against. -->
                <Grid x:Name="MediaFileContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Height="160"
                            HorizontalAlignment="Stretch"
                            CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border.Background>

                        <!-- Video-only overlay so a video's large thumbnail (often just a generic
                             shell icon, since not every codec has a real preview handler) still
                             reads as "video" rather than "image". -->
                        <Border x:Name="VideoBadge"
                                Width="24" Height="24"
                                CornerRadius="12"
                                Background="#B0000000"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,6,6"
                                Visibility="Collapsed">
                            <TextBlock Text="&#9654;" FontSize="10" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>

                    <!-- ToolTip is Subtitle (the full path), not Title (just the file name): same
                         convention as FilesSingleContent's own subtitle line below, so hovering
                         any file card's name always reveals the full path, media or not. -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Title}"
                               ToolTip="{Binding Subtitle}"
                               FontSize="{DynamicResource CardFontSize}"
                               Foreground="{StaticResource Card.Foreground}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0" />
                </Grid>

                <!-- Files, stack (2+ items): layered-paper icon + count badge, with the first
                     path's shell icon (CardViewModel.FileIcon) drawn on the frontmost layer when
                     available. StackIcon stays Collapsed (plain layered squares, as before) when
                     FileIcon is null, since the stack never had a text-glyph fallback to begin
                     with. -->
                <Grid x:Name="FilesStackContent" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="34" Height="34" Margin="0,0,10,0">
                        <Border Background="{StaticResource Card.StackLayer1}" CornerRadius="4"
                                Width="26" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,4,0,0" />
                        <Border Background="{StaticResource Card.StackLayer2}" CornerRadius="4"
                                Width="26" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="4,2,0,0" />
                        <Border Background="{StaticResource Card.StackLayer3}" CornerRadius="4"
                                Width="26" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Image x:Name="StackIcon"
                               Source="{Binding FileIcon}"
                               Width="18" Height="18" />
                        <Border Background="{StaticResource Card.Badge}" CornerRadius="8"
                                Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding StackCount}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   ToolTip="{Binding Title}"
                                   FontSize="{DynamicResource CardFontSize}"
                                   Foreground="{StaticResource Card.Foreground}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   ToolTip="{Binding Subtitle}"
                                   FontSize="{DynamicResource CardSmallFontSize}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource Card.SubForeground}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Files, stack (2+ items), first path is media (v1.2 Task A): the same
                     large-thumbnail visual as MediaFileContent above (full card width, Height=160,
                     UniformToFill, rounded corners) instead of the layered-paper look, with the
                     count badge kept on top and the "ファイル N 件" title below on one line. Shown
                     in place of FilesStackContent above when CardViewModel.StackThumbnail resolves
                     to a real image (HasStackThumbnail==True, see the IsStack MultiDataTrigger
                     below); falls back to FilesStackContent's icon look when it comes back null
                     (first file missing/no thumbnail handler, or the first path is a non-media
                     type). -->
                <Grid x:Name="StackMediaContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="160">
                        <Border HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding StackThumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <!-- Video-only overlay, same chrome as MediaFileContent's own VideoBadge,
                             for a stack whose first path is a video. -->
                        <Border x:Name="StackVideoBadge"
                                Width="24" Height="24"
                                CornerRadius="12"
                                Background="#B0000000"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,6,6"
                                Visibility="Collapsed">
                            <TextBlock Text="&#9654;" FontSize="10" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Count badge kept on top of the large thumbnail, top-left so it never
                             overlaps the video badge's bottom-right corner. Same accent brush as
                             FilesStackContent's own badge for a consistent "this is a stack" cue. -->
                        <Border Background="{StaticResource Card.Badge}" CornerRadius="10"
                                Width="20" Height="20"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="6,6,0,0">
                            <TextBlock Text="{Binding StackCount}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Title}"
                               ToolTip="{Binding Title}"
                               FontSize="{DynamicResource CardFontSize}"
                               Foreground="{StaticResource Card.Foreground}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0" />
                </Grid>

                <!-- Hover-only action pill (v1.3 Task D): pin/delete float in a dark pill at the
                     card's top edge instead of sitting bare on the card content (the old flat
                     ActionBar above) - the earlier icons were invisible on a white image. Same
                     Tag="Pin"/"Delete" buttons, same Card.ActionButton style, same
                     ShelfWindow.OnCardActionClick class handler - only the container changed, per
                     the task brief ("only their visual container moves").

                     Visibility (not just Opacity) is still what gates hit-testing, same rationale
                     as before: an Opacity=0 element is still hit-testable in WPF, which would let
                     the invisible Delete button eat clicks/taps meant for whatever's behind it
                     when the card isn't hovered. It is now driven by the Enter/ExitActions
                     storyboards below (see the IsMouseOver trigger) instead of a plain Setter, so
                     leaving the card fades the pill out over ~120ms instead of popping it away on
                     the first frame - a plain Setter reverts the instant the trigger goes false,
                     which would cut the fade-out animation off before it is ever seen.

                     The negative top margin lets the pill overlap CardRoot's own rounded top edge,
                     like the reference screenshot. Nothing BETWEEN this Border and the ScrollViewer
                     clips it: CardRoot has no ClipToBounds, neither does Card.ListBoxItemStyle's
                     ContentPresenter template, and neither StackPanel nor VirtualizingStackPanel
                     (ShelfWindow.xaml's ItemsPanel for PinnedList/CardsList) clips per item. -8
                     would put the pill's top edge flush with CardRoot's outer border (CardRoot's
                     Padding="8" is what the Grid above is already inset by); the extra -6 is the
                     actual overhang past that edge, capped there so it stays inside the 8px gap
                     Card.ListBoxItemStyle's own Margin="0,0,0,8" leaves between one card and the
                     next and never touches the card above.

                     The ScrollViewer's OWN viewport clip is a separate matter, and IS always active
                     regardless of ClipToBounds elsewhere (review round 1 finding): at scroll offset
                     0 the topmost card sits at content Y=0, so a naive -6px overhang above it would
                     land at Y<0 and get its top corners flattened. Fixed at the source, not by
                     shrinking the overhang - but not with Padding on both lists either, as review
                     round 1 first tried (probe-proven ineffective for CardsList: see the fix
                     comment on CardsList itself in ShelfWindow.xaml). The reservation now differs
                     per list, because the two are built differently: PinnedList is a plain
                     ItemsControl with no ScrollViewer of its own, so its Padding always acted
                     directly on its content and stays as-is. CardsList is a ListBox, whose default
                     template has an internal ScrollViewer that Padding would forward to (insetting
                     the viewport instead of offsetting content), so CardsList's reservation instead
                     lives as a Margin="0,8,0,0" on its own ItemsPanel (the VirtualizingStackPanel),
                     which pushes the items themselves down inside whatever viewport it is given.
                     Either way the 6px overhang lands inside an 8px reserved band, at every scroll
                     position including offset 0 - not just for the first card, since the same
                     reservation exists at the top of the list regardless of which card ends up
                     there after a store rebuild. -->
                <Border x:Name="ActionPill"
                        Style="{StaticResource Card.ActionPillStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-14,6,0"
                        Opacity="0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Button Tag="Pin" Style="{StaticResource Card.PinActionButtonStyle}" Margin="0" />
                        <!-- Edit action (v1.7): only Text/Link cards can be edited, so the button collapses on
                             Image/Files cards instead of being disabled - a disabled button would still widen the
                             pill and invite "why is this greyed out" on cards where editing has no meaning. -->
                        <Button Content="&#9998;" Tag="Edit" Margin="0"
                                ToolTip="{x:Static res:Strings.ActionEdit}"
                                AutomationProperties.Name="{x:Static res:Strings.ActionEdit}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Card.ActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Link">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Final review fix (v1.8): a text stack still reports Kind==Text,
                                             so the trigger above would leave Edit visible on it too - but a
                                             text stack has no single body to edit. Listed after the Kind
                                             triggers so it wins the tie, same override pattern as the
                                             TextStackContent trigger below. -->
                                        <DataTrigger Binding="{Binding IsTextStack}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Rename action (v1.8): only stacks (file or text) can be named, so the
                             button collapses on single cards - same reasoning as the Edit button
                             above collapsing on non-Text/Link cards. -->
                        <Button Content="&#127991;" Tag="Rename" Margin="0"
                                ToolTip="{x:Static res:Strings.ActionRename}"
                                AutomationProperties.Name="{x:Static res:Strings.ActionRename}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Card.ActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStack}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTextStack}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Subtle separator ahead of Delete (design brief: "delete stays visually
                             distinct, rightmost, subtle separation", to cut down on accidental
                             hits) - a 1px divider plus its own margin, rather than just a wider
                             gap, so the line reads as an intentional boundary rather than looking
                             like uneven spacing. -->
                        <Border Width="1" Margin="5,4" Background="{StaticResource Card.PillSeparator}" />
                        <Button Content="&#128465;" Tag="Delete" Style="{StaticResource Card.ActionButton}" Margin="0"
                                ToolTip="{x:Static res:Strings.ActionDelete}"
                                AutomationProperties.Name="{x:Static res:Strings.ActionDelete}" />
                    </StackPanel>
                </Border>

                <!-- Multi-select indicator (Task 15): an accent border overlay + a checkmark badge,
                     toggled by CardViewModel.Selected. Deliberately a SEPARATE element from
                     CardRoot's own BorderBrush rather than reusing it: Task 14's merge highlight
                     sets CardRoot.BorderBrush imperatively in code-behind (a local value, which
                     outranks a template trigger's setter), so sharing the property would let a
                     drag-hover silently erase the selected indicator underneath it. -->
                <Border x:Name="SelectionOverlay"
                        BorderBrush="{StaticResource Card.SelectedAccent}"
                        BorderThickness="2"
                        CornerRadius="8"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                <!-- 20x20, not 18x18: the checkmark's FontSize is CardSmallFontSize, which reaches
                     15px at TextScale.Large - 18px left almost no headroom around a 15px glyph
                     and started clipping against the circle. Bumped rather than made a fourth
                     DynamicResource key, per the review's "bump if it clips" (this badge's size is
                     cosmetic chrome around the glyph, not reading text that itself needs to scale
                     proportionally). -->
                <Border x:Name="SelectionCheck"
                        Width="20"
                        Height="20"
                        CornerRadius="10"
                        Background="{StaticResource Card.SelectedAccent}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,2,2"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <TextBlock Text="&#10003;"
                               FontSize="{DynamicResource CardSmallFontSize}"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Text">
                <Setter TargetName="TextContent" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Link">
                <Setter TargetName="LinkContent" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Image">
                <Setter TargetName="ImageContent" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Files">
                <Setter TargetName="FilesSingleContent" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- v1.8: listed after the Kind DataTriggers above so it wins the tie over the plain
                 Kind=="Text" trigger, same override pattern IsStack uses below for Files. -->
            <DataTrigger Binding="{Binding IsTextStack}" Value="True">
                <Setter TargetName="TextContent" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TextStackContent" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- Listed after the Files DataTrigger above: on a tie, the later trigger's setters
                 win, so a stack (IsStack==true) ends up showing FilesStackContent instead. -->
            <DataTrigger Binding="{Binding IsStack}" Value="True">
                <Setter TargetName="FilesSingleContent" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="FilesStackContent" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- v1.2 Task A: listed after the IsStack trigger above so it wins the tie, same
                 override pattern as the null-Thumbnail fallback further down: when the stack's
                 StackThumbnail actually resolves, swap the layered-icon look for the large-thumbnail
                 one instead. HasStackThumbnail stands in for "StackThumbnail != null" because a
                 DataTrigger can only match a literal value. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsStack}" Value="True" />
                    <Condition Binding="{Binding HasStackThumbnail}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="FilesStackContent" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="StackMediaContent" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding StackFirstMedia}" Value="Video">
                <Setter TargetName="StackVideoBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- Also listed after the Files DataTrigger, for the same reason: a lone media file
                 (image or video) overrides the default FilesSingleContent look with the large
                 thumbnail. Mutually exclusive with IsStack (a media file always has exactly one
                 path), so the two triggers never fight over the same target. -->
            <DataTrigger Binding="{Binding IsMediaFile}" Value="True">
                <Setter TargetName="FilesSingleContent" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="MediaFileContent" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- Deleted-file fallback (v1.1 review): a media file whose Thumbnail came back null
                 (ShellImaging could not produce one - most commonly because the file was deleted
                 after being dropped) would otherwise render MediaFileContent's 160px preview box
                 empty. Listed after the IsMediaFile trigger above so it wins the tie and falls
                 back to the ordinary FilesSingleContent look (icon + name) instead. Both
                 conditions are needed, not just Thumbnail=={x:Null}: Kind==Image cards also read
                 Thumbnail, and a missing blob thumbnail there must stay on ImageContent, not
                 borrow this Files-only fallback. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMediaFile}" Value="True" />
                    <Condition Binding="{Binding Thumbnail}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="FilesSingleContent" Property="Visibility" Value="Visible" />
                <Setter TargetName="MediaFileContent" Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Media}" Value="Video">
                <Setter TargetName="VideoBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- Shell-icon-missing fallbacks: the left-slot icon (single non-media file) and the
                 stack's frontmost-layer icon both default to showing CardViewModel.FileIcon, and
                 fall back to the pre-existing look (generic glyph / plain layered squares) when
                 the shell had nothing to offer for that path. -->
            <DataTrigger Binding="{Binding FileIcon}" Value="{x:Null}">
                <Setter TargetName="FileIconContent" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="FileIconGlyph" Property="Visibility" Value="Visible" />
                <Setter TargetName="StackIcon" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <!-- ActionPill's Visibility/Opacity are animated, not Setter-driven (see the comment
                 above ActionPill itself for why): EnterActions plays a ~130ms fade in, ExitActions
                 a ~120ms fade out (both inside the brief's ~120-150ms target) with Visibility
                 flipped to Collapsed only once that fade has actually finished (the
                 DiscreteObjectKeyFrame's KeyTime), so leaving the card is visibly a fade rather
                 than a pop. -->
            <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource Card.HoverBackground}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionPill" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="ActionPill" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.13" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ActionPill" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.12" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionPill" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter TargetName="SelectionOverlay" Property="Visibility" Value="Visible" />
                <Setter TargetName="SelectionCheck" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ListBoxItem chrome for the main card list: no default selection highlight (selection
         isn't wired up until Task 15), spacing between cards done here rather than baked into
         CardItemTemplate so the same template can be reused edge-to-edge in the pinned deck. -->
    <Style x:Key="Card.ListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Container for a card inside the pinned accordion (v1.2 Task H). Was a fixed 200px wide
         cell in a horizontal deck; now full width with the SAME 0,0,0,8 bottom margin
         Card.ListBoxItemStyle gives a main-list card, so a pinned card and an unpinned one below it
         are spaced identically and the two sections read as one continuous column. -->
    <Style x:Key="Card.PinnedContainerStyle" TargetType="ContentPresenter">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Header row of the pinned accordion (v1.2 Task H): a full-width, flat, borderless Button
         whose whole surface is the toggle. Focusable=False for the same reason as
         Header.IconButtonStyle: the shelf is WS_EX_NOACTIVATE and only the search box is ever meant
         to take keyboard focus, so this must fire its Click without competing for it.

         Foreground was Card.SubForeground (v1.3 Task E: bumped to the brighter Card.Foreground) -
         the boundary tint on the section around it (ShelfWindow.xaml's PinnedSection Border) makes
         the header row read as a distinct region now, so the muted sub-text color that worked for a
         plain background started reading as too faint against it. -->
    <Style x:Key="Pinned.HeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Card.Foreground}" />
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card.ActionHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Batch action bar button (Task 15): same dark pill chrome as the footer's Clear button,
         factored out here so the four buttons in ShelfWindow's SelectionBar don't each need their
         own inline <Button.Resources> Border-CornerRadius override. -->
    <Style x:Key="SelectionBarButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Background" Value="{StaticResource Card.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Card.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource CardSmallFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card.HoverBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter tab pill. Label text + count badge is built in ShelfWindow.xaml.cs (it needs to
         refresh live as ShelfViewModel.Count* changes), and the active/inactive look is also
         toggled there - kept out of XAML triggers because "which tab is active" isn't a
         property on any single bound object, it's a comparison against ShelfViewModel.Filter. -->
    <Style x:Key="FilterTabButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{StaticResource Card.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Card.SubForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource CardFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card.HoverBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
