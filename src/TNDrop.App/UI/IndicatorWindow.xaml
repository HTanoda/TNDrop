<Window x:Class="TNDrop.UI.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNDrop Indicator"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        Left="-1000" Top="0" Width="64" Height="400"
        Background="Transparent">
    <!-- Every group starts Opacity="0"; Flash() picks one, restarts its animation, then resets
         Opacity back to 0 when the animation completes (see IndicatorWindow.xaml.cs). The window
         is click-through (WindowStyles.MakeClickThrough), so IsHitTestVisible="False" documents
         intent rather than changing behavior.

         v1.5: each style is a "body + outline" pair inside one container Grid, and the flash
         animates the CONTAINER's opacity so both always light up together. The dark outline
         carries visibility on bright backgrounds, the bright fill on dark ones - the production
         feedback that started v1.5 was exactly "invisible on light desktops". All colors here are
         placeholders overwritten by ApplyPalette() in code-behind, the single funnel from the
         IndicatorColor setting through IndicatorPalette.Resolve; they are kept roughly correct as
         a design-time fallback only. Elements are x:Name'd individually because StaticResource is
         resolved once at parse time and could not be retargeted per-setting-change. -->
    <Grid IsHitTestVisible="False">
        <!-- Beacon: a soft 6px light with a 10px dark halo behind it, centered on the edge. -->
        <Grid x:Name="BeaconGroup" Opacity="0" VerticalAlignment="Center">
            <Rectangle x:Name="BeaconOutlineRect" Width="10" Height="140">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="BeaconOutlineStart" Offset="0.0" Color="#00325F73" />
                        <GradientStop x:Name="BeaconOutlineMid" Offset="0.5" Color="#FF325F73" />
                        <GradientStop x:Name="BeaconOutlineEnd" Offset="1.0" Color="#00325F73" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="BeaconLight" Width="6" Height="140">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="BeaconGradientStart" Offset="0.0" Color="#005AC8FA" />
                        <GradientStop x:Name="BeaconGradientMid" Offset="0.5" Color="#FF5AC8FA" />
                        <GradientStop x:Name="BeaconGradientEnd" Offset="1.0" Color="#005AC8FA" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Bar: a 3px bar on a 7px dark backing, spanning the full work-area height. -->
        <Grid x:Name="BarGroup" Opacity="0" VerticalAlignment="Stretch">
            <Rectangle x:Name="BarOutlineRect" Width="7" VerticalAlignment="Stretch">
                <Rectangle.Fill>
                    <SolidColorBrush x:Name="BarOutlineBrush" Color="#FF325F73" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="BarLight" Width="3" VerticalAlignment="Stretch">
                <Rectangle.Fill>
                    <SolidColorBrush x:Name="BarBrush" Color="#FF5AC8FA" />
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Pulse: an expanding circle; the 2px stroke keeps a dark rim while it grows. -->
        <Grid x:Name="PulseGroup" Opacity="0" VerticalAlignment="Center">
            <Ellipse x:Name="PulseCircle"
                     Width="8" Height="8"
                     StrokeThickness="2"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <SolidColorBrush x:Name="PulseBrush" Color="#FF5AC8FA" />
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <SolidColorBrush x:Name="PulseStrokeBrush" Color="#FF325F73" />
                </Ellipse.Stroke>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- Corner: a small outlined dot near the bottom of the work area. -->
        <Grid x:Name="CornerGroup" Opacity="0" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <Ellipse x:Name="CornerDot"
                     Width="10" Height="10"
                     StrokeThickness="1.5">
                <Ellipse.Fill>
                    <SolidColorBrush x:Name="CornerBrush" Color="#FF5AC8FA" />
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <SolidColorBrush x:Name="CornerStrokeBrush" Color="#FF325F73" />
                </Ellipse.Stroke>
            </Ellipse>
        </Grid>
    </Grid>
</Window>
