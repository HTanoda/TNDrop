<Window x:Class="TNDrop.UI.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FF1A1A1F"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        Standard window chrome (v1.6 Task 7), same reasoning as SettingsWindow's own comment:
        this window needs real activation and normal keyboard focus for its PasswordBoxes,
        unlike the click-through overlay windows in this app (indicator/edge-trigger bands).
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Dlg.Foreground" Color="#FFF2F2F7" />
        <SolidColorBrush x:Key="Dlg.SubForeground" Color="#FFA5A5AD" />
        <SolidColorBrush x:Key="Dlg.Border" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="Dlg.HoverBorder" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="Dlg.FieldBackground" Color="#FF232329" />
        <SolidColorBrush x:Key="Dlg.ErrorForeground" Color="#FFFF6B6B" />

        <!--
            Shared FocusVisualStyle (review fix round 1, same as SettingsWindow.xaml's own
            Settings.FocusVisual): WPF's default FocusVisualStyle draws its dashed keyboard-focus
            adorner with a SystemColors-tracking brush, near-invisible against this window's
            permanent #FF1A1A1F background. This dialog is reached by Tab/Enter (OkButton is
            IsDefault, CancelButton is IsCancel) as a real keyboard path, not just mouse clicks, so
            a visible ring matters here too. Applied below to PasswordBox and Dlg.Button.
        -->
        <Style x:Key="Dlg.FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   Stroke="#B3FFFFFF"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="1 2"
                                   RadiusX="5" RadiusY="5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dlg.Foreground}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="Dlg.HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Dlg.SubForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Dlg.ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Dlg.ErrorForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            Re-templated for the same reason every other input control in this app is (see
            SettingsWindow.xaml's ComboBox/CheckBox comments): PasswordBox's default chrome is
            drawn from the OS visual style and tracks SystemColors, not this window's permanent
            dark palette - a plain Background/Foreground Setter alone would leave a light-theme
            box glaring out of this dark window.
        -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Dlg.FieldBackground}" />
            <Setter Property="Foreground" Value="{StaticResource Dlg.Foreground}" />
            <Setter Property="CaretBrush" Value="{StaticResource Dlg.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Dlg.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Dlg.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Dlg.HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Dlg.HoverBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Dlg.Button" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A31" />
            <Setter Property="Foreground" Value="{StaticResource Dlg.Foreground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Dlg.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Dlg.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center"
                                               RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Dlg.HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" Margin="0,0,0,4" />
        <PasswordBox x:Name="Box1" Margin="0,0,0,12" />

        <TextBlock x:Name="ConfirmLabelText" Margin="0,0,0,4" />
        <PasswordBox x:Name="Box2" Margin="0,0,0,12" />

        <TextBlock x:Name="HintText" Style="{StaticResource Dlg.HintText}" Margin="0,0,0,8" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource Dlg.ErrorText}" Margin="0,0,0,8" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Style="{StaticResource Dlg.Button}" Margin="0,0,8,0" MinWidth="84"
                    IsDefault="True" Click="OnOkClick" />
            <Button x:Name="CancelButton" Style="{StaticResource Dlg.Button}" MinWidth="84" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
